package com.example.myetresq;

import android.content.Intent;
import android.os.Bundle;
import android.os.Handler;
import android.provider.Settings;
import android.widget.Button;
import android.widget.TextView;
import android.widget.Toast;

import androidx.appcompat.app.AppCompatActivity;

import java.net.HttpURLConnection;
import java.net.URL;

public class ControllingActivity3 extends AppCompatActivity {

    // ================= UI =================
    private TextView txtStatus, txtWifiStatus, txtIndicator;
    private Button btnSpeed1, btnSpeed2, btnSpeed3, btnStop;
    private Button btnConnectWifi, buttonBack;

    // ================= ESP32 =================
    private static final String ESP32_BASE_URL = "http://192.168.4.1";

    // ================= HANDLER =================
    private Handler handler = new Handler();
    private Runnable wifiChecker;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_controlling3);

        // ===== INIT VIEW =====
        txtStatus = findViewById(R.id.txtStatus);
        txtWifiStatus = findViewById(R.id.txtWifiStatus);
        txtIndicator = findViewById(R.id.txtIndicator);

        btnSpeed1 = findViewById(R.id.btnSpeed1);
        btnSpeed2 = findViewById(R.id.btnSpeed2);
        btnSpeed3 = findViewById(R.id.btnSpeed3);
        btnStop   = findViewById(R.id.btnStop);

        btnConnectWifi = findViewById(R.id.btnConnectWifi);
        buttonBack     = findViewById(R.id.buttonBack);

        // ===== DEFAULT STATE =====
        enableControl(false);
        setLed(false);
        txtStatus.setText("STATUS: -");

        // ===== BUTTON LISTENER =====
        btnConnectWifi.setOnClickListener(v ->
                startActivity(new Intent(Settings.ACTION_WIFI_SETTINGS)));

        btnSpeed1.setOnClickListener(v ->
                sendCommand("/speed100", "STATUS: SPEED 1"));

        btnSpeed2.setOnClickListener(v ->
                sendCommand("/speed180", "STATUS: SPEED 2"));

        btnSpeed3.setOnClickListener(v ->
                sendCommand("/speed225", "STATUS: SPEED 3"));

        btnStop.setOnClickListener(v ->
                sendCommand("/stop", "STATUS: STOP"));

        buttonBack.setOnClickListener(v -> finish());

        // ===== AUTO CHECK ESP32 (1 DETIK) =====
        wifiChecker = new Runnable() {
            @Override
            public void run() {
                checkEsp32();
                handler.postDelayed(this, 1000);
            }
        };
    }

    @Override
    protected void onResume() {
        super.onResume();
        handler.post(wifiChecker);
    }

    @Override
    protected void onPause() {
        super.onPause();
        handler.removeCallbacks(wifiChecker);
    }

    // ================= CHECK ESP32 =================
    private void checkEsp32() {
        new Thread(() -> {
            boolean connected = false;

            try {
                URL url = new URL(ESP32_BASE_URL + "/");
                HttpURLConnection conn = (HttpURLConnection) url.openConnection();
                conn.setConnectTimeout(1000);
                conn.setReadTimeout(1000);
                conn.setRequestMethod("GET");

                connected = (conn.getResponseCode() == 200);
                conn.disconnect();

            } catch (Exception ignored) {}

            boolean finalConnected = connected;
            runOnUiThread(() -> updateUi(finalConnected));
        }).start();
    }

    private void updateUi(boolean connected) {
        if (connected) {
            txtWifiStatus.setText("WiFi: ESP32 Connected");
            setLed(true);
            enableControl(true);
        } else {
            txtWifiStatus.setText("WiFi: ESP32 Not Connected");
            setLed(false);
            enableControl(false);
        }
    }

    // ================= SEND COMMAND =================
    private void sendCommand(String endpoint, String statusText) {
        new Thread(() -> {
            try {
                URL url = new URL(ESP32_BASE_URL + endpoint);
                HttpURLConnection conn = (HttpURLConnection) url.openConnection();
                conn.setConnectTimeout(2000);
                conn.setReadTimeout(2000);
                conn.setRequestMethod("GET");

                if (conn.getResponseCode() == 200) {
                    runOnUiThread(() -> txtStatus.setText(statusText));
                } else {
                    showToast("ESP32 tidak merespon");
                }

                conn.disconnect();

            } catch (Exception e) {
                showToast("Gagal kirim perintah");
            }
        }).start();
    }

    // ================= LED =================
    private void setLed(boolean on) {
        if (on) {
            txtIndicator.setBackgroundResource(R.drawable.led_green);
        } else {
            txtIndicator.setBackgroundResource(R.drawable.led_red);
        }
    }

    // ================= BUTTON ENABLE =================
    private void enableControl(boolean enable) {
        btnSpeed1.setEnabled(enable);
        btnSpeed2.setEnabled(enable);
        btnSpeed3.setEnabled(enable);
        btnStop.setEnabled(enable);
    }

    // ================= TOAST =================
    private void showToast(String msg) {
        runOnUiThread(() ->
                Toast.makeText(this, msg, Toast.LENGTH_SHORT).show());
    }
}
